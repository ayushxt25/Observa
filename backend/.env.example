# Backend development example. Production must override security-sensitive values.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://observa:observa@localhost:5432/observa
REDIS_URL=redis://localhost:6379/0
MAX_INGEST_BATCH_SIZE=5000
MAX_QUERY_ROWS=10000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,https://performance-dashboard-rose.vercel.app
REDIS_STREAM_NAME=telemetry:events
TELEMETRY_STREAM_MAXLEN=100000
ALERT_SCAN_INTERVAL_SECONDS=5
JWT_SECRET_KEY=change-me-32-byte-minimum-for-production
JWT_ISSUER=observa-api
JWT_AUDIENCE=observa
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_NAME=observa_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REGISTER=10
AUTH_RATE_LIMIT_LOGIN=20
AUTH_RATE_LIMIT_REFRESH=60
INGESTION_RATE_LIMIT_PER_MINUTE=600
NOTIFICATION_SECRET_KEY=change-me-32-byte-minimum-for-production
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_SCAN_INTERVAL_SECONDS=15
NOTIFICATION_DELIVERY_LEASE_SECONDS=120
NOTIFICATION_TEST_RATE_LIMIT_PER_MINUTE=20
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@observa.local
SMTP_TLS=true
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
WEBHOOK_TIMEOUT_SECONDS=5
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL_SECONDS=30
QUERY_CACHE_MAX_BYTES=1000000
